# Variables de entorno — NO commitear .env con valores reales
# Cargar en Azure SWA → Settings → Environment Variables

# ── SMTP — Gmail App Password ──────────────────────────────────────────────────
# Generá el App Password en: myaccount.google.com/apppasswords
EMAIL_USERNAME=gbertonnft@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_NOTIFICATIONS_TO=gberton1967@gmail.com

# ── AI Battle — APIs para generate-predictions.mjs ────────────────────────────
# Correr localmente: node scripts/generate-predictions.mjs
# Las keys NO van a Azure SWA (el script corre local, pushea el JSON)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin — update-result endpoint ────────────────────────────────────────────
# Token secreto para cargar resultados reales después de cada partido
# Usar en header: x-admin-token: <valor>
ADMIN_TOKEN=reemplazar-con-token-secreto-largo
